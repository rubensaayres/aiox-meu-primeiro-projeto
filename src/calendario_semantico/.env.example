# --- CONFIGURAÇÕES DO MOTOR SEMÂNTICO ---

# Modelo do Ollama que deve estar baixado (ex: llama3, mistral, phi3)
OLLAMA_MODEL=llama3

# --- CONFIGURAÇÕES DO GMAIL ---
# Seu endereço de e-mail do Gmail
GMAIL_USER=seu_email@gmail.com

# ATENÇÃO: Não é a senha normal do seu e-mail!
# Você deve criar uma "Senha de App" nas configurações de segurança da sua Conta Google.
GMAIL_PASS=sua_senha_de_app_do_gmail
